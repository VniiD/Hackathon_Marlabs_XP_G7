# true  = dados simulados em src/api/mock.ts (não precisa do backend)
# false = chama o FastAPI em /api/v1 (via proxy do Vite em dev)
VITE_USE_MOCKS=false
VITE_API_BASE_URL=/api/v1
# Para onde o Vite encaminha /api em dev. Use IPv4 para evitar conflitos com ::1.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
